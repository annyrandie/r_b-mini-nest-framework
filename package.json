{
  "name": "mini-nest",
  "version": "1.0.0",
  "private": true,
  "description": "Own IoC container + full request lifecycle (middleware/guard/interceptor/pipe/filter), built the way NestJS builds them under the hood — part 3 of 3.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:watch": "tsc -p tsconfig.json -w"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^6.0.3"
  }
}
