{
  "name": "mini-nest",
  "version": "1.0.0",
  "private": true,
  "description": "Own IoC container + HTTP layer, built the way NestJS builds them under the hood — part 2 of 3.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:watch": "tsc -p tsconfig.json -w"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^6.0.3"
  }
}
